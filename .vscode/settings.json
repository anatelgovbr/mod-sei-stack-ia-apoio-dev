{
    "chat.useAgentsMdFile": true,
    "chat.useNestedAgentsMdFiles": false,
    "chat.agentSkillsLocations": {
        ".agents/skills": true,
        ".github/skills": false,
        ".claude/skills": false,
        "~/.copilot/skills": false,
        "~/.agents/skills": false,
        "~/.claude/skills": false
    },
    "files.eol": "auto",
    "[php]": {
        "files.encoding": "iso88591"
    },
    "[markdown]": {
        "files.encoding": "utf8"
    },
    "[shellscript]": {
        "files.eol": "\n"
    },
    "[makefile]": {
        "files.eol": "\n"
    },
    "[dockerfile]": {
        "files.eol": "\n"
    },
    "[yaml]": {
        "files.eol": "\n"
    }
}
